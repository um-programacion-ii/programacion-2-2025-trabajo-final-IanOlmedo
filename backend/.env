# ===================================================================
# Variables de entorno del backend
# ===================================================================

SPRING_PROFILES_ACTIVE=dev

# Servicio HTTP de la cátedra (Sacar mas adelante)
CAT_SERVICE_URL=http://192.168.194.250:8080/api
CAT_SERVICE_TOKEN=

# Base de Datos - PostgreSQL con Docker (postgres-tpfinal-programacion2)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/backendCatedra
SPRING_DATASOURCE_USERNAME=backendCatedra
SPRING_DATASOURCE_PASSWORD=backendCatedra
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_DOCKER_COMPOSE_ENABLED=false

# Redis remoto de la cátedra
# Para que esto funcione, debo estar conectado a ZeroTier y tener autorizada mi IP por la cátedra.
REDIS_HOST=192.168.194.250
REDIS_PORT=6379
# Opción alternativa (solo para pruebas locales sin cátedra):
# REDIS_HOST=localhost

# Kafka remoto de la cátedra
KAFKA_BROKER=192.168.194.250
KAFKA_PORT=9092

# URL base del proxy del alumno
PROXY_BASE_URL=http://localhost:8081/api/proxy

